{
  "name": "diffs-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "bridge": "tsx bridge/server.ts",
    "build": "tsc -b && vite build && npm run build:bridge",
    "build:bridge": "esbuild bridge/server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/bridge.mjs",
    "test": "node --import tsx --test bridge/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "ts-check": "tsc --noEmit",
    "lint": "eslint src bridge",
    "format": "prettier --write src bridge *.json *.ts *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.5"
  }
}
