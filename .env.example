# Copy to .env.local for local packaging. These are public ingestion settings.
DONKEY_DIFF_POSTHOG_KEY=
DONKEY_DIFF_POSTHOG_HOST=https://us.i.posthog.com

# Release credentials belong in GitHub Actions secrets, never this file.
# See RELEASES.md for the complete secret names and encoding.

# Optional local agent executable paths (set in the bridge process environment)
# DONKEY_DIFF_CODEX_BIN=/absolute/path/to/codex
# DONKEY_DIFF_CLAUDE_BIN=/absolute/path/to/claude
